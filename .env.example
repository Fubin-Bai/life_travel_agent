# 通用配置：将占位值替换为自己的Key；不要提交真实.env。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
AMAP_WEB_SERVICE_KEY=your_amap_web_service_key_here

# 一、V1：固定Python高德取证；不启用Agent/Harness/RAG。
# LIFE_JOURNEY_PLANNING_MODE=amap
# LIFE_JOURNEY_VALIDATION=0

# 二、Agent：工具选择、Harness、约束校验与有限重规划。
# LIFE_JOURNEY_PLANNING_MODE=agent
# LIFE_JOURNEY_VALIDATION=1

# 三、RAG：当前展示默认；包括Agent/Harness/校验修复和长期记忆检索。
# 三组只保留一组生效；下面三个Embedding配置必须填写。
LIFE_JOURNEY_PLANNING_MODE=memory
LIFE_JOURNEY_VALIDATION=1
LIFE_JOURNEY_EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
LIFE_JOURNEY_EMBEDDING_MODEL=BAAI/bge-m3
LIFE_JOURNEY_EMBEDDING_KEY=your_siliconflow_embedding_key_here

# Harness可选预算覆盖；未设置时长表示不启用整次协作式时限。
# LIFE_JOURNEY_MAX_TOOL_CALLS=12
# LIFE_JOURNEY_MAX_RUN_SECONDS=300
